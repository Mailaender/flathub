{
  "app-id": "io.github.dfaust.soundKonverter",
  "runtime": "org.kde.Platform",
  "runtime-version": "5.15-21.08",
  "sdk": "org.kde.Sdk",
  "command": "soundkonverter",
  "rename-icon": "soundkonverter",
  "rename-desktop-file": "soundkonverter.desktop",
  "rename-appdata-file": "soundkonverter.appddata.xml",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--filesystem=xdg-music",
    "--filesystem=/run/media",
    "--filesystem=/media",
    "--device=dri"
  ],
  "cleanup": [
    "*.la",
    "*.a",
    "/include",
    "/share/man"
  ],
  "modules": [
    {
      "name": "kdelibs4support",
      "buildsystem": "cmake-ninja",
      "sources": [
        {
          "type": "archive",
          "url": "https://download.kde.org/stable/frameworks/5.94/portingAids/kdelibs4support-5.94.0.tar.xz",
          "sha256": "d726ebb00766d3d5ed39603601c4b9541659bebc4bb7b755eec25bffd8a76033",
          "x-checker-data": {
            "type": "anitya",
            "project-id": 8762,
            "stable-only": true,
            "url-template": "https://download.kde.org/stable/frameworks/$major.$minor/portingAids/kdelibs4support-$version.tar.xz"
          }
        }
      ]
    },
    {
      "name": "libneon",
      "config-opts": [
        "--enable-shared",
        "--with-gssapi",
        "--with-libxml2"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "http://www.webdav.org/neon/neon-0.30.2.tar.gz",
          "sha256": "db0bd8cdec329b48f53a6f00199c92d5ba40b0f015b153718d1b15d3d967fbca"
        }
      ]
    },
    {
      "name": "libmusicbrainz",
      "buildsystem": "cmake",
      "config-opts": [
        "-DBUILD_SHARED_LIBS=ON"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/metabrainz/libmusicbrainz/releases/download/release-5.1.0/libmusicbrainz-5.1.0.tar.gz",
          "sha256": "6749259e89bbb273f3f5ad7acdffb7c47a2cf8fcaeab4c4695484cef5f4c6b46"
        }
      ]
    },
    {
      "name": "libkcddb",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DBUILD_TESTING=OFF"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.kde.org/stable/release-service/22.12.0/src/libkcddb-22.12.0.tar.xz",
          "sha256": "5150623351c9be4f4a0c44a3e33475650627accd5d9d3d4cfcc74e115fe0d4d4",
          "x-checker-data": {
            "type": "anitya",
            "project-id": 8763,
            "stable-only": true,
            "url-template": "https://download.kde.org/stable/release-service/$version/src/libkcddb-$version.tar.xz"
          }
        }
      ]
    },
    {
      "name": "cdparanoia",
      "buildsystem": "autotools",
      "sources": [
        {
          "type": "archive",
          "url": "http://downloads.xiph.org/releases/cdparanoia/cdparanoia-III-10.2.src.tgz",
          "sha256": "005db45ef4ee017f5c32ec124f913a0546e77014266c6a1c50df902a55fe64df"
        },
        {
          "type": "patch",
          "path": "cdparanoia-use-proper-gnu-config-files.patch"
        },
        {
          "type": "patch",
          "path": "010_build_system.patch"
        },
        {
          "type": "patch",
          "path": "cdparanoia-III-ide_majors.patch",
          "strip-components": 0
        },
        {
          "type": "patch",
          "path": "cdparanoia-III-c++.patch",
          "strip-components": 0
        },
        {
          "type": "patch",
          "path": "050_all_build_only_shared_libraries.patch",
          "strip-components": 0
        },
        {
          "type": "patch",
          "path": "cdparanoia-III-01-typos-and-spelling.dpatch"
        },
        {
          "type": "patch",
          "path": "cdparanoia-III-05-gcc4.3.dpatch"
        },
        {
          "type": "patch",
          "path": "cdparanoia-III-06-endian.dpatch"
        },
        {
          "type": "shell",
          "commands": [
            "cp /usr/share/automake-*/config.{sub,guess} ."
          ]
        }
      ]
    },
    "shared-modules/vorbisgain/vorbisgain_0.37-2.json",
    {
      "name": "wavpack",
      "sources": [
        {
          "type": "archive",
          "url": "https://www.wavpack.com/wavpack-5.4.0.tar.bz2",
          "sha256": "0716a6dcf9a72d61005e1b09bbbd61aaf49837cb4e4a351992a6daed16cac034"
        }
      ]
    },
    {
      "name": "soundkonverter",
      "buildsystem": "cmake-ninja",
      "subdir": "src",
      "builddir": true,
      "config-opts": "-DKF5_BUILD=ON",
      "post-install": [
        "install -Dm644 ../../soundkonverter128.png ${FLATPAK_DEST}/share/icons/hicolor/128x128/apps/soundkonverter.png"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/dfaust/soundkonverter",
          "commit": "ca9583660e5a7c02052aecd2e64a99e5011a8699"
        },
        {
          "type": "patch",
          "path": "appstream.patch"
        },
        {
          "type": "file",
          "path": "soundkonverter128.png"
        }
      ]
    }
  ]
}
